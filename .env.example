# 이 파일을 .env 로 복사해서 채우세요. .env는 git에 올라가지 않습니다.
#   cp .env.example .env

# 디스코드 채널 -> 채널 설정 -> 연동 -> 웹후크 -> 새 웹후크 -> URL 복사
DISCORD_WEBHOOK_URL=

# --- 결제수단: 토스페이 (booking.pay_method: toss) ---
# 토스에 가입된 번호와 생년월일. 봇이 여기까지 넣으면 폰으로 결제 알림이 오고,
# 승인만 폰에서 하면 된다. 카드 정보를 저장할 필요가 없어서 이 방식을 권한다.
TOSS_PHONE=010-1234-5678
TOSS_BIRTH6=910101

# --- 결제수단: CGV 간편결제(저장카드) ---
# 카드를 CGV에 등록해 뒀을 때의 결제 비밀번호. 토스를 쓰면 비워두세요. (현재 미사용)
CGV_PAY_PASSWORD=
